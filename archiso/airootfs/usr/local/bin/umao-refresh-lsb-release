#!/usr/bin/env bash
set -euo pipefail

cat > /etc/lsb-release <<'EOF'
LSB_VERSION=1.4
DISTRIB_ID=UmaOS
DISTRIB_RELEASE=rolling
DISTRIB_CODENAME=uma
DISTRIB_DESCRIPTION="UmaOS"
EOF

# On stock Arch /etc/os-release is a symlink to the filesystem-package-owned
# /usr/lib/os-release; writing through it would clobber the package file.
# Remove the (possibly restored) symlink so we create a real file instead.
rm -f /etc/os-release
cat > /etc/os-release <<'EOF'
NAME="UmaOS"
PRETTY_NAME="UmaOS"
ID=umaos
ID_LIKE=arch
BUILD_ID=rolling
ANSI_COLOR="38;2;66;165;75"
HOME_URL="https://github.com/pod32g/umaos"
DOCUMENTATION_URL="https://github.com/pod32g/umaos#readme"
SUPPORT_URL="https://github.com/pod32g/umaos/issues"
BUG_REPORT_URL="https://github.com/pod32g/umaos/issues"
LOGO=umaos-launcher
EOF
