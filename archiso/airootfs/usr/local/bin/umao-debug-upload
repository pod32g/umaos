#!/usr/bin/env bash
set -euo pipefail

# umao-debug-upload — upload a umao-debug diagnostics bundle to a remote host
# over SCP.
#
# By default it uploads the newest bundle produced by `umao-debug`
# ($TMPDIR/umao-debug-*.tar.gz). Prefer key-based SSH auth; --password is
# supported for convenience but is less secure (the password is visible to
# other local processes via the argument list while scp runs).

HOST=""
USER_NAME=""
PASSWORD=""
FILE=""
DEST=""
PORT="22"
# Must match where umao-debug writes bundles. It no longer defaults to
# world-writable /tmp (predictable path + world-readable diagnostics), so look
# in the XDG state dir first and keep /tmp as a fallback for older bundles.
DEFAULT_DIR="${XDG_STATE_HOME:-${HOME:-}/.local/state}/umaos"
FALLBACK_DIR="${TMPDIR:-/tmp}"

log() {
  printf '[umao-debug-upload] %s\n' "$*" >&2
}

usage() {
  cat <<'EOF'
Usage: umao-debug-upload --host <ip> --user <user> [options]

Uploads a umao-debug diagnostics bundle to a remote host over SCP.

Required:
  --host <ip|hostname>   Destination host
  --user <user>          SSH username on the destination host

Options:
  --password <pass>      SSH password (requires 'sshpass'). Less secure than
                         key-based auth; omit to use SSH keys or be prompted.
  --file <path>          Bundle to upload
                         (default: newest $TMPDIR/umao-debug-*.tar.gz)
  --dest <remote-path>   Remote destination directory or path (default: home)
  --port <port>          SSH port (default: 22)
  --help                 Show this help

Examples:
  umao-debug-upload --host <host> --user <user>
  umao-debug-upload --host 10.0.0.5 --user me --file ~/.local/state/umaos/umao-debug-host-...tar.gz

Prefer key-based auth. --password requires sshpass; the password is passed via
the SSHPASS environment variable rather than argv, but key auth avoids handling
it altogether.
EOF
}

while (($# > 0)); do
  case "$1" in
    --host)     [[ $# -ge 2 ]] || { log "Missing value for --host"; exit 2; };     HOST="$2"; shift 2 ;;
    --host=*)   HOST="${1#*=}"; shift ;;
    --user)     [[ $# -ge 2 ]] || { log "Missing value for --user"; exit 2; };     USER_NAME="$2"; shift 2 ;;
    --user=*)   USER_NAME="${1#*=}"; shift ;;
    --password) [[ $# -ge 2 ]] || { log "Missing value for --password"; exit 2; }; PASSWORD="$2"; shift 2 ;;
    --password=*) PASSWORD="${1#*=}"; shift ;;
    --file)     [[ $# -ge 2 ]] || { log "Missing value for --file"; exit 2; };     FILE="$2"; shift 2 ;;
    --file=*)   FILE="${1#*=}"; shift ;;
    --dest)     [[ $# -ge 2 ]] || { log "Missing value for --dest"; exit 2; };     DEST="$2"; shift 2 ;;
    --dest=*)   DEST="${1#*=}"; shift ;;
    --port)     [[ $# -ge 2 ]] || { log "Missing value for --port"; exit 2; };     PORT="$2"; shift 2 ;;
    --port=*)   PORT="${1#*=}"; shift ;;
    --help|-h)  usage; exit 0 ;;
    *)          log "Unknown argument: $1"; usage >&2; exit 2 ;;
  esac
done

[[ -n "$HOST" ]] || { log "Missing required --host"; usage >&2; exit 2; }
[[ -n "$USER_NAME" ]] || { log "Missing required --user"; usage >&2; exit 2; }
if ! [[ "$PORT" =~ ^[0-9]+$ ]]; then
  log "--port must be a number (got: $PORT)"
  exit 2
fi

# Resolve the bundle to upload.
if [[ -z "$FILE" ]]; then
  # Newest umao-debug bundle in the default directory (by mtime). The trailing
  # '|| true' keeps a failed/empty pipeline (e.g. head closing the pipe under
  # pipefail, or no matches) from tripping 'set -e' before the check below.
  # Search the XDG state dir first, then /tmp for bundles from older versions.
  # Only consider files we own: auto-picking the newest match from a shared
  # /tmp let any local user plant a bundle for us to upload to a remote host.
  FILE="$(find "${DEFAULT_DIR%/}" "${FALLBACK_DIR%/}" -maxdepth 1 -type f \
    -name 'umao-debug-*.tar.gz' -user "$(id -u)" \
    -printf '%T@\t%p\n' 2>/dev/null | sort -rn | head -n1 | cut -f2- || true)"
  if [[ -z "$FILE" ]]; then
    log "No bundle found in ${DEFAULT_DIR%/} (umao-debug-*.tar.gz)."
    log "Run 'umao-debug' first, or pass --file <path>."
    exit 1
  fi
  log "Using newest bundle: $FILE"
fi
if [[ ! -f "$FILE" ]]; then
  log "Bundle not found: $FILE"
  exit 1
fi

# Validate before building argv: a --host/--user/--file value starting with "-"
# is otherwise parsed by scp as an option (e.g. --host '-oProxyCommand=...'
# would run a command), and an unvalidated host can smuggle scp syntax.
if [[ ! "$HOST" =~ ^[A-Za-z0-9._:-]+$ || "$HOST" == -* ]]; then
  log "Invalid --host: $HOST"
  exit 1
fi
if [[ ! "$USER_NAME" =~ ^[A-Za-z0-9._-]+$ || "$USER_NAME" == -* ]]; then
  log "Invalid --user: $USER_NAME"
  exit 1
fi
if [[ ! "$PORT" =~ ^[0-9]+$ ]] || ((PORT < 1 || PORT > 65535)); then
  log "Invalid --port: $PORT"
  exit 1
fi

# accept-new trusts a first-seen host key (so the password flow works
# non-interactively) but still refuses if a known key later changes.
# The "--" terminates option parsing so a file path starting with "-" is
# treated as a path.
scp_opts=(-P "$PORT" -o ConnectTimeout=15 -o StrictHostKeyChecking=accept-new --)
target="${USER_NAME}@${HOST}:${DEST}"

log "Uploading $(basename "$FILE") to ${USER_NAME}@${HOST}:${DEST:-~} (port $PORT) ..."

if [[ -n "$PASSWORD" ]]; then
  if ! command -v sshpass >/dev/null 2>&1; then
    log "--password given but 'sshpass' is not installed."
    log "Install it (sudo pacman -S sshpass) or use key-based auth instead."
    exit 1
  fi
  # `sshpass -p "$PASSWORD"` puts the password in argv, where every local user
  # can read it from /proc/<pid>/cmdline for the lifetime of the transfer.
  # sshpass -e takes it from the environment instead, which is not world
  # readable.
  SSHPASS="$PASSWORD" sshpass -e scp "${scp_opts[@]}" "$FILE" "$target"
else
  log "(no --password; using SSH keys or an interactive prompt)"
  scp "${scp_opts[@]}" "$FILE" "$target"
fi

log "Upload complete."
echo "Umazing!"
