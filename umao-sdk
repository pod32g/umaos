#!/usr/bin/env bash
# umao-sdk — UmaOS developer toolkit
# v2 scope: only 'build-package' subcommand

set -euo pipefail

usage() {
    cat <<EOF
Usage: umao-sdk <command>

Commands:
    build-package    Build current directory into an Arch package

Options:
    -h, --help       Show this help
EOF
}

cmd_build_package() {
    if [[ ! -f PKGBUILD ]]; then
        echo "ERROR: No PKGBUILD found in current directory" >&2
        exit 1
    fi

    if ! command -v makepkg >/dev/null 2>&1 || ! command -v fakeroot >/dev/null 2>&1; then
        echo "ERROR: makepkg/fakeroot not available. Install the build toolchain first:" >&2
        echo "  sudo pacman -S --needed base-devel" >&2
        exit 1
    fi

    echo "Building package from $(pwd)..."

    # makepkg refuses to run as root; hand the tree to a temp build user,
    # restoring the original ownership afterwards even if the build fails.
    if [[ "${EUID:-$(id -u)}" -eq 0 ]]; then
        echo "Running as root — building via temp build user..."
        local orig_owner
        orig_owner="$(stat -c '%u:%g' .)"
        useradd -m _umao_build 2>/dev/null || true
        # Allow the build user to install build deps (makepkg -s calls
        # sudo pacman); scoped to pacman only and removed on exit.
        printf '_umao_build ALL=(ALL) NOPASSWD: /usr/bin/pacman\n' \
            > /etc/sudoers.d/50-umao-build
        chmod 0440 /etc/sudoers.d/50-umao-build
        # shellcheck disable=SC2064  -- expand orig_owner/pwd now, on purpose
        trap "chown -R '$orig_owner' '$(pwd)'; rm -f /etc/sudoers.d/50-umao-build" EXIT
        chown -R _umao_build:_umao_build .
        sudo -u _umao_build makepkg -s --needed --noconfirm "$@"
    else
        makepkg -s --needed --noconfirm "$@"
    fi

    echo ""
    echo "Build complete! Package files:"
    ls -la *.pkg.tar.* 2>/dev/null || echo "  (no package files produced)"
}

case "${1:-}" in
    build-package)
        shift
        cmd_build_package "$@"
        ;;
    -h|--help|"")
        usage
        ;;
    *)
        echo "Unknown command: $1" >&2
        usage
        exit 1
        ;;
esac
